---
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import { stamps, stampSvg } from '../../data/stamps';
import { site } from '../../data/site';
const first = site.name.split(' ')[0];
---

<section id="letters" class="mail" aria-labelledby="mail-title" data-web3forms={site.web3formsKey} data-email={site.email}>
  <header class="mail__head wrap">
    <p class="t-mono"><span class="t-accent">Index 004</span> <span class="t-faint">/</span> Mailroom <span class="t-faint">— the deepest room</span></p>
    <h2 id="mail-title" class="t-h1" data-split>You scrolled all the way down.<br /><span class="t-faint">Leave a letter?</span></h2>
    <p class="t-lead t-dim mail__sub">Liked a case study? Spotted something off? Want to talk about an internship? Write it, doodle on it, stamp it. It goes straight up the tube to my inbox.</p>
  </header>

  <div class="mail__desk wrap">
    <form class="letter" novalidate>
      <div class="sheet-wrap">
        <div class="sheet" data-sheet>
          <div class="sheet__top">
            <p class="sheet__date t-mono" data-date></p>
            <div class="sheet__stamp" data-stamp-slot set:html={stampSvg('crt')} aria-hidden="true"></div>
          </div>
          <p class="sheet__dear hand">Dear {first},</p>
          <label class="sr-only" for="l-msg">Your letter</label>
          <textarea id="l-msg" name="message" class="hand sheet__text" rows="9" maxlength="2400" placeholder="Write anything: what worked, what didn't, a job, a joke…" required data-lenis-prevent></textarea>
          <div class="sheet__sign hand">
            <span>—</span>
            <label class="sr-only" for="l-name">Your name</label>
            <input id="l-name" name="name" type="text" maxlength="60" placeholder="your name" autocomplete="name" required />
          </div>
          <canvas class="sheet__doodle" data-doodle aria-label="Doodle area" data-cursor="draw"></canvas>
        </div>
      </div>

      <div class="tools win">
        <div class="win__bar"><span class="win__dots"><i></i><i></i><i></i></span><span>mailroom.app</span></div>
        <div class="tools__body">
          <div class="step">
            <p class="step__k t-mono"><b>01</b> Pen</p>
            <div class="tools__row" role="radiogroup" aria-label="Pen mode">
              <button type="button" class="tool is-on" data-mode="write" role="radio" aria-checked="true"><span class="t-pixel">Aa</span> Write</button>
              <button type="button" class="tool" data-mode="draw" role="radio" aria-checked="false"><span class="t-pixel">✎</span> Doodle</button>
            </div>
            <div class="tools__row" data-pens aria-label="Pen colour">
              <button type="button" class="pen is-on" data-pen="ink" aria-label="Ink pen"><i style="background:#161616; outline:1px solid var(--line)"></i></button>
              <button type="button" class="pen" data-pen="accent" aria-label="Phosphor pen"><i style="background:var(--accent)"></i></button>
              <button type="button" class="pen" data-pen="red" aria-label="Red pencil"><i style="background:#e0442b"></i></button>
              <button type="button" class="pen" data-pen="erase" aria-label="Eraser"><i class="erase"></i></button>
              <button type="button" class="tool tool--sm" data-clear>Clear doodle</button>
            </div>
          </div>

          <fieldset class="step stamps">
            <legend class="step__k t-mono"><b>02</b> Stamp</legend>
            <div class="stamps__row">
              {Object.entries(stamps).map(([key, s], i) => (
                <label class="stamp-opt" title={s.label}>
                  <input type="radio" name="stamp" value={key} checked={i === 0} />
                  <span class="stamp-opt__face" set:html={stampSvg(key)} />
                  <span class="sr-only">{s.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="step field">
            <span class="step__k t-mono"><b>03</b> Return address <span class="t-faint">· optional, so I can write back</span></span>
            <input name="email" type="email" maxlength="120" placeholder="you@somewhere.com" autocomplete="email" />
          </label>
          <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="step step--send">
            <p class="mail__err t-mono" data-err role="alert"></p>
            <button type="submit" class="btn btn--solid send">Seal &amp; send <span class="arr">✉</span></button>
            <p class="t-mono t-faint mail__fine">Only I read it. No list, no newsletter.</p>
          </div>
        </div>
      </div>

      <aside class="tray" aria-label="Outgoing tray">
        <p class="t-mono t-faint tray__label"><span class="t-accent">●</span> Outgoing tray</p>
        <div class="mini-env" aria-hidden="true">
          <div class="mini-env__stamp" data-stamp-mini set:html={stampSvg('crt')}></div>
          <div class="mini-env__pm t-mono">Mailroom<br /><b>−44 m</b></div>
          <p class="mini-env__from t-mono"><span class="t-faint">From</span> <span data-from-name>someone kind</span><br /><span class="t-faint" data-from-mail>no return address</span></p>
          <p class="mini-env__to hand">{site.name}<br /><span class="t-mono">The Archive, −44 m</span></p>
        </div>
        <dl class="receipt t-mono">
          <div><dt>Postage</dt><dd>Free</dd></div>
          <div><dt>Route</dt><dd>Pneumatic tube, straight up</dd></div>
          <div><dt>Arrives</dt><dd>My inbox, in about a second</dd></div>
          <div><dt>Replies</dt><dd>If you leave an address, I write back</dd></div>
          <div><dt>Doodles</dt><dd>Strongly encouraged</dd></div>
        </dl>
        <p class="tray__alt t-mono t-faint">Rather use your own mail app? <a class="link-u" href={`mailto:${site.email}`} data-no-wipe>{site.email}</a></p>
      </aside>
    </form>

    <!-- the envelope, built from four layers so the letter can slide between them -->
    <div class="env" aria-hidden="true" data-env>
      <div class="env__back"></div>
      <div class="env__slot" data-slot></div>
      <div class="env__front">
        <span class="env__to hand">{site.name}<br /><span class="t-mono">The Archive, −44 m</span></span>
        <div class="env__stamp" data-env-stamp></div>
        <div class="env__postmark t-mono">Sent from<br />the mailroom<br /><b data-pm-date></b></div>
      </div>
      <div class="env__flap"></div>
    </div>

    <div class="tube" aria-hidden="true"><i></i></div>

    <div class="mail__done" data-done hidden tabindex="-1">
      <p class="t-pixel mail__done-big">✉ Delivered.</p>
      <p class="t-lead" data-done-msg></p>
      <button type="button" class="btn" data-again>Write another <span class="arr">↺</span></button>
    </div>
  </div>
</section>

<style>
  .mail { position: relative; z-index: 2; background: var(--bg); padding: clamp(96px, 14vh, 160px) 0 clamp(120px, 16vh, 200px); border-top: 1px solid var(--line); overflow: hidden; }
  .mail__head { display: grid; gap: 20px; margin-bottom: clamp(40px, 7vh, 72px); }
  .mail__sub { max-width: 60ch; }
  .mail__desk { position: relative; min-height: 720px; }
  .hand { font-family: var(--font-hand); }

  .mail__head, .mail__desk { max-width: 1640px; margin-inline: auto; }
  .letter { display: grid; grid-template-columns: minmax(0, 620px) minmax(320px, 400px) minmax(260px, 1fr); gap: clamp(24px, 3.4vw, 56px); align-items: start; transition: opacity 0.3s; }
  .sheet-wrap { perspective: 1400px; }
  .sheet {
    --ink-on-paper: #161616;
    position: relative; aspect-ratio: 210 / 260; padding: 34px 40px 30px 56px;
    background: #fbfaf5; color: #161616;
    background-image:
      linear-gradient(90deg, transparent 38px, #ef8f7d 38px 39px, transparent 39px),
      repeating-linear-gradient(180deg, transparent 0 33px, #c9d7e4 33px 34px);
    background-position: 0 0, 0 23px;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04), 0 30px 60px -30px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(0 0 0 / 0.08);
    display: grid; grid-template-rows: auto auto 1fr auto; transform-origin: center;
  }
  .sheet__top { display: flex; justify-content: space-between; align-items: start; height: 52px; }
  .sheet__date { font-size: 10.5px; color: #6b6b66; padding-top: 6px; }
  .sheet__stamp { width: 52px; height: 60px; padding: 5px; background: #fff; outline: 2px dotted #c9c7bf; outline-offset: -1px; color: #161616; --accent: var(--accent); }
  .sheet__stamp :global(svg) { width: 100%; height: 100%; }
  .sheet__dear { font-size: 30px; line-height: 34px; margin-top: 12px; }
  .sheet__text {
    width: 100%; resize: none; border: 0; outline: none; background: transparent;
    font-size: 27px; line-height: 34px; color: #161616; padding: 0; min-height: 0; height: 100%;
  }
  .sheet__text::placeholder { color: #a9a8a1; }
  .sheet__sign { display: flex; gap: 8px; align-items: baseline; justify-content: flex-end; font-size: 28px; line-height: 34px; }
  .sheet__sign input { border: 0; outline: none; background: transparent; font: inherit; color: #161616; width: 200px; border-bottom: 1px dashed #bdbcb5; }
  .sheet__doodle { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; touch-action: none; }
  .letter.is-drawing .sheet__doodle { pointer-events: auto; }
  .letter.is-drawing .sheet { outline: 2px solid var(--accent); outline-offset: 6px; }

  .tools { align-self: start; }
  .tools__body { display: grid; }
  .step { display: grid; gap: 12px; padding: 20px 22px; border: 0; margin: 0; min-width: 0; }
  .step + .step { border-top: 1px dashed var(--line); }
  .step__k { color: var(--ink-2); padding: 0; }
  .step__k b { color: var(--accent-ink); font-weight: 500; margin-right: 6px; }
  .step--send { gap: 10px; }
  .tools__row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .tool { height: 38px; padding: 0 14px; border: 1px solid var(--line-strong); font: 500 12px/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em; display: inline-flex; align-items: center; gap: 8px; }
  .tool.is-on { background: var(--ink); color: var(--bg); }
  .tool--sm { height: 30px; padding: 0 10px; font-size: 10.5px; }
  .pen { width: 30px; height: 30px; border: 1px solid var(--line); display: grid; place-items: center; }
  .pen i { width: 14px; height: 14px; display: block; }
  .pen i.erase { border: 1px solid var(--ink); background: repeating-linear-gradient(45deg, transparent 0 3px, var(--ink-3) 3px 4px); }
  .pen.is-on { border-color: var(--ink); outline: 1px solid var(--ink); }
  .letter:not(.is-drawing) [data-pens] { opacity: 0.4; }
  .stamps legend { float: left; width: 100%; margin-bottom: 12px; }
  .stamps__row { display: flex; gap: 8px; flex-wrap: wrap; }
  .stamp-opt { position: relative; }
  .stamp-opt input { position: absolute; opacity: 0; inset: 0; }
  .stamp-opt__face { display: block; width: 52px; height: 58px; padding: 6px; background: #fbfaf5; color: #161616; outline: 2px dotted #c9c7bf; outline-offset: -2px; transition: transform 0.2s var(--ease-out); }
  .stamp-opt__face :global(svg) { width: 100%; height: 100%; }
  .stamp-opt:hover .stamp-opt__face { transform: rotate(-4deg) translateY(-2px); }
  .stamp-opt input:checked + .stamp-opt__face { outline: 2px solid var(--ink); outline-offset: 2px; transform: rotate(-3deg); }
  .stamp-opt input:focus-visible + .stamp-opt__face { outline: 2px solid var(--accent-ink); }
  .field { display: grid; gap: 8px; }
  .field input { height: 44px; border: 1px solid var(--line-strong); background: transparent; padding: 0 12px; font: 400 15px/1 var(--font-sans); }
  .field input:focus { outline: 2px solid var(--accent-ink); outline-offset: 1px; }
  .send { justify-self: stretch; justify-content: center; height: 56px; padding: 0 26px; font-size: 13px; }
  .mail__err { color: #e0442b; text-transform: none; }
  .mail__err:empty { display: none; }
  .mail__fine { text-transform: none; }

  /* outgoing tray: a live preview of what gets sent */
  .tray { display: grid; gap: 22px; align-content: start; max-width: 440px; padding-top: 4px; }
  .tray__label { display: flex; gap: 8px; align-items: center; }
  .mini-env {
    position: relative; aspect-ratio: 1.6; background: #e9e3d3; color: #161616; border: 1px solid #161616;
    box-shadow: 10px 10px 0 -1px var(--bg), 10px 10px 0 0 var(--line-strong);
    transform: rotate(-2.5deg); transition: transform 0.5s var(--ease-out);
  }
  .mini-env::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom right, transparent calc(50% - 0.6px), #161616 50%, transparent calc(50% + 0.6px)) left top / 50% 56% no-repeat, linear-gradient(to bottom left, transparent calc(50% - 0.6px), #161616 50%, transparent calc(50% + 0.6px)) right top / 50% 56% no-repeat; opacity: 0.18; }
  .tray:hover .mini-env { transform: rotate(0deg) translateY(-4px); }
  .mini-env__stamp { position: absolute; right: 6%; top: 9%; width: 15%; aspect-ratio: 52 / 58; padding: 4px; background: #fff; outline: 2px dotted #b8b4a8; outline-offset: -2px; }
  .mini-env__stamp :global(svg) { width: 100%; height: 100%; }
  .mini-env__pm { position: absolute; right: 22%; top: 8%; width: 21%; aspect-ratio: 1; border-radius: 50%; border: 1.5px solid #3a3a3a; display: grid; place-items: center; text-align: center; font-size: 8px; line-height: 1.3; color: #3a3a3a; transform: rotate(-14deg); opacity: 0.5; }
  .mini-env__from { position: absolute; left: 6%; top: 9%; font-size: 10px; line-height: 1.5; text-transform: none; max-width: 44%; overflow-wrap: anywhere; }
  .mini-env__from .t-faint { color: #6b6b66; }
  .mini-env__to { position: absolute; left: 30%; bottom: 12%; font-size: clamp(20px, 1.7vw, 28px); line-height: 1.05; }
  .mini-env__to .t-mono { font-size: 10px; }
  .receipt { display: grid; border-top: 1px solid var(--line-strong); text-transform: none; font-size: 12px; margin: 0; }
  .receipt div { display: grid; grid-template-columns: 9ch 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px dashed var(--line); }
  .receipt dt { color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.04em; font-size: 11px; }
  .receipt dd { margin: 0; color: var(--ink); }
  .tray__alt { text-transform: none; font-size: 11.5px; line-height: 1.6; }
  .tray__alt a { color: var(--ink-2); }

  /* envelope */
  .env { position: absolute; left: 50%; top: 40px; width: min(520px, 86vw); aspect-ratio: 1.6; translate: -50% 0; pointer-events: none; visibility: hidden; perspective: 1000px; z-index: 5; }
  .env__back, .env__front, .env__flap { position: absolute; inset: 0; }
  .env__back { background: #d8d2c2; border: 1px solid #161616; }
  .env__back { z-index: 0; }
  .env__slot { position: absolute; left: 6%; right: 6%; top: 8%; bottom: 6%; z-index: 1; }
  .env__front {
    background: #e9e3d3; border: 1px solid #161616; color: #161616;
    clip-path: polygon(0 32%, 50% 62%, 100% 32%, 100% 100%, 0 100%);
    z-index: 2;
  }
  .env__front::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to top right, transparent calc(50% - 0.6px), #161616 50%, transparent calc(50% + 0.6px)) left bottom / 50% 70% no-repeat, linear-gradient(to top left, transparent calc(50% - 0.6px), #161616 50%, transparent calc(50% + 0.6px)) right bottom / 50% 70% no-repeat; opacity: 0.3; }
  .env__to { position: absolute; left: 10%; bottom: 14%; font-size: 28px; line-height: 1.05; }
  .env__to .t-mono { font-size: 10px; }
  .env__stamp { position: absolute; right: 7%; bottom: 14%; width: 62px; height: 70px; padding: 6px; background: #fff; outline: 2px dotted #b8b4a8; outline-offset: -2px; opacity: 0; }
  .env__stamp :global(svg) { width: 100%; height: 100%; }
  .env__postmark { position: absolute; right: 13%; bottom: 31%; width: 92px; height: 92px; border-radius: 50%; border: 2px solid #3a3a3a; display: grid; place-items: center; text-align: center; font-size: 8.5px; line-height: 1.25; color: #3a3a3a; transform: rotate(-14deg); opacity: 0; mix-blend-mode: multiply; }
  .env__flap {
    background: #ddd6c5; border: 1px solid #161616; transform-origin: top center;
    clip-path: polygon(0 0, 100% 0, 50% 62%); transform: rotateX(180deg); z-index: 0;
  }
  .tube { position: absolute; left: 50%; top: -200px; width: 120px; height: 260px; translate: -50% 0; pointer-events: none; opacity: 0; border-inline: 2px solid var(--ink); }
  .tube i { position: absolute; inset: auto 0 0 0; height: 14px; border: 2px solid var(--ink); margin-inline: -10px; background: var(--bg); }

  .mail__done { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 18px; text-align: center; }
  .mail__done-big { font-size: clamp(40px, 6vw, 80px); line-height: 1; }

  @media (max-width: 1360px) {
    .letter { grid-template-columns: minmax(0, 620px) minmax(320px, 1fr); }
    .tray { grid-column: 2; max-width: none; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .tray__label, .tray__alt { grid-column: 1 / -1; }
  }
  @media (max-width: 1100px) { .tray { grid-template-columns: 1fr; } }
  @media (max-width: 900px) {
    .letter { grid-template-columns: 1fr; }
    .tray { grid-column: auto; }
    .sheet { padding: 26px 22px 22px 46px; aspect-ratio: auto; min-height: 520px; }
    .sheet__text { font-size: 24px; min-height: 260px; }
  }
</style>
