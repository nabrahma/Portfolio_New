---
// First visit per session: a quiet title card on ink. The name rises in either side of a
// pixel-type counter that runs 000 → 100 at its own pace once the world is built, then the
// card breaks up in the page-wipe cells, outward from the middle (src/scripts/boot.ts).
---

<div class="boot" data-boot aria-hidden="true">
  <div class="boot__card">
    <p class="boot__name is-left t-h2" data-boot-name>Nabaskar</p>
    <p class="boot__count t-pixel" data-boot-count>000</p>
    <p class="boot__name is-right t-h2" data-boot-name>Brahma</p>
  </div>
</div>

<style>
  .boot { display: none; }
  :global(.is-booting) .boot {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 9500; overflow: hidden;
    background: var(--ink); color: var(--bg); cursor: progress;
    animation: boot-failsafe 0s 9s forwards; /* if the script never runs, never trap the page */
  }
  @keyframes boot-failsafe { to { visibility: hidden; } }
  /* nothing of the page may show around the card: the bars stay hidden until it breaks up, and
     the root background is ink too, so a strip the browser hasn't repainted yet still matches */
  :global(html.is-booting:not(.is-boot-out)) :global(:is(.menubar, .statusbar)) { visibility: hidden; animation: boot-bars 0s 9s forwards; }
  :global(html.is-booting:not(.is-boot-out)) :global(body) { background: var(--ink); animation: boot-body 0s 9s forwards; }
  /* the same failsafe for these two */
  @keyframes boot-bars { to { visibility: visible; } }
  @keyframes boot-body { to { background: var(--bg); } }
  .boot__card { display: flex; align-items: center; gap: clamp(18px, 3vw, 48px); }
  .boot__name { margin: 0; opacity: 0; white-space: nowrap; }
  .boot__count {
    margin: 0; font-size: clamp(64px, 11vw, 168px); line-height: 0.8;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 560px) {
    .boot__card { flex-direction: column; gap: 14px; }
  }
</style>
