---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '../../data/site';
import { projects } from '../../data/projects';
import { renders } from '../../data/three-d';

// Scroll sinks the camera down the CRT's cable. Each layer of soil shows a bit more of me:
// who I am, what I design, how it moves, the worlds I build, and then the archive.
const thumb = (src: ImageMetadata, w = 240) => getImage({ src, width: w, format: 'webp' });
const designed = await Promise.all(
  projects.filter((p) => ['margin', 'ruko', 'thriftup'].includes(p.slug)).map(async (p) => ({ p, img: await thumb(p.cover, 320) })),
);
const worlds = await Promise.all(
  renders.filter((r) => ['window-rain', 'woods', 'sunset'].includes(r.slug)).map(async (r) => ({ r, img: await thumb(r.image, 320) })),
);

const strata = [
  { at: [0.15, 0.3], depth: '−3 m', name: 'Topsoil', side: 'left', kind: 'me', title: 'Hi, I’m Nabaskar.', body: `A ${site.role} and ${site.roleNext} from India. I like products that feel calm, and scenes that feel lived in.` },
  { at: [0.31, 0.47], depth: '−13 m', name: 'Subsoil', side: 'right', kind: 'design', title: 'I design products.', body: 'Apps and sites, end to end: the flow, the screens, and the small states nobody draws, like offline, empty and almost-done.' },
  { at: [0.48, 0.64], depth: '−22 m', name: 'Clay', side: 'left', kind: 'motion', title: 'I make them move.', body: 'Prototypes tuned until a tap feels physical. Motion is how an interface explains itself.' },
  { at: [0.65, 0.81], depth: '−31 m', name: 'Bedrock', side: 'right', kind: '3d', title: 'I build little worlds.', body: `Quiet, cinematic 3D scenes: one figure, a lot of light. ${renders.length} renders so far.` },
  { at: [0.83, 1.01], depth: '−44 m', name: 'The archive', side: 'left', kind: 'archive', title: 'Five projects, dug up.', body: 'Each one starts at the surface and goes all the way down. Open a folder.' },
];
const chips: Record<string, string[]> = {
  design: ['Flows', 'Wireframes', 'UI', 'Design systems'],
  motion: ['Prototyping', 'Interaction', 'Smart Animate'],
  '3d': ['Environments', 'Lighting', 'Mood'],
};
const ticks = Array.from({ length: 47 }, (_, i) => i);
---

<section id="descent" class="descent" aria-label="A quick look at me and what I do">
  <div class="descent__stick">
    {strata.map((s, i) => (
      <article class={`stratum is-${s.side}`} data-at={s.at.join(',')}>
        <p class="t-mono stratum__label"><span class="t-accent tnum">{s.depth}</span> <span class="t-faint">·</span> {s.name} <span class="t-faint">· layer 0{i + 1}</span></p>
        <h2 class="t-h2 stratum__title">{s.title}</h2>
        <p class="stratum__body">{s.body}</p>

        {s.kind === 'me' && (
          <dl class="idcard t-mono" data-st-item>
            <div><dt>Studying</dt><dd>B.Tech (IT) + MBA, IIITM Gwalior</dd></div>
            <div><dt>Graduating</dt><dd>2028</dd></div>
            <div><dt>Status</dt><dd><i class="dot"></i>{site.status}</dd></div>
          </dl>
        )}

        {s.kind === 'design' && (
          <div class="thumbs" data-st-item>
            {designed.map(({ p, img }) => (
              <a class="thumb" href={`/work/${p.slug}`} data-cursor={`label:${p.title}`} style={`--tint:${p.tint}`}>
                <img src={img.src} alt="" width={img.attributes.width} height={img.attributes.height} loading="lazy" decoding="async" />
                <span class="t-mono">{p.code}</span>
              </a>
            ))}
          </div>
        )}

        {s.kind === 'motion' && (
          <a class="reel" href="/work/what-if" data-st-item data-cursor="label:What if…?">
            <video src="/video/stack-preview.webm" muted loop playsinline preload="none" data-st-video aria-hidden="true"></video>
            <span class="reel__cap t-mono"><span class="t-accent">●</span> What if…? · live prototype</span>
          </a>
        )}

        {s.kind === '3d' && (
          <div class="thumbs is-wide" data-st-item>
            {worlds.map(({ r, img }) => (
              <a class="thumb" href={`/3d#${r.slug}`} data-cursor={`label:${r.title}`}>
                <img src={img.src} alt="" width={img.attributes.width} height={img.attributes.height} loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        )}

        {s.kind !== 'me' && s.kind !== 'archive' && (
          <ul class="chips t-mono" aria-label="Skills">
            {chips[s.kind].map((c) => <li data-st-item>{c}</li>)}
          </ul>
        )}

        {s.kind === 'archive' && (
          <a class="btn btn--solid" href="#work" data-st-item data-cursor="label:open ↓">Open the drawer <span class="arr">↓</span></a>
        )}
      </article>
    ))}

    <div class="ruler t-pixel" aria-hidden="true">
      <div class="ruler__track">
        {ticks.map((t) => (
          <span class={t % 5 === 0 ? 'is-major' : ''}>{t % 5 === 0 ? `-${t}` : ''}</span>
        ))}
      </div>
      <i class="ruler__needle"></i>
    </div>
  </div>
</section>

<style>
  .descent { position: relative; z-index: 1; height: 520vh; }
  .descent__stick { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .stratum {
    position: absolute; inset-block: 0; margin-block: auto; height: fit-content; width: min(440px, 80vw);
    padding: 24px 26px 26px; display: grid; gap: 14px; justify-items: start;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border: 1px solid var(--line);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    visibility: hidden;
  }
  .js .stratum { opacity: 0; }
  .stratum.is-left { left: max(var(--pad), 6vw); }
  .stratum.is-right { right: calc(max(var(--pad), 6vw) + 56px); }
  .stratum__title { margin: 0; }
  .stratum__body { color: var(--ink-2); font-size: 15.5px; line-height: 1.55; }

  .idcard { display: grid; width: 100%; margin: 4px 0 0; border-top: 1px solid var(--line); text-transform: none; font-size: 12px; }
  .idcard div { display: grid; grid-template-columns: 11ch 1fr; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  .idcard dt { color: var(--ink-3); text-transform: uppercase; font-size: 10.5px; letter-spacing: 0.04em; }
  .idcard dd { margin: 0; }
  .dot { display: inline-block; width: 7px; height: 7px; margin-right: 8px; background: var(--accent); box-shadow: 0 0 8px var(--accent); }

  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 100%; margin-top: 4px; }
  .thumb { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--tint, #111); border: 1px solid var(--line); }
  .thumbs.is-wide .thumb { aspect-ratio: 4 / 3; background: #050505; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.7s var(--ease-out), filter 0.4s; }
  .thumbs.is-wide .thumb img { object-position: center; }
  .thumb span { position: absolute; left: 6px; bottom: 6px; font-size: 10px; padding: 2px 5px; background: var(--ink); color: var(--bg); }
  .thumb:hover img { transform: scale(1.06); }

  .reel { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #e9e7e1; border: 1px solid var(--line); margin-top: 4px; }
  .reel video { width: 100%; height: 100%; object-fit: contain; }
  .reel__cap { position: absolute; left: 8px; bottom: 8px; font-size: 10px; padding: 3px 6px; background: var(--bg); color: var(--ink); text-transform: none; }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .chips li { font-size: 11px; padding: 5px 9px; border: 1px solid var(--line-strong); }

  .ruler { position: absolute; right: var(--pad); top: 0; bottom: 0; width: 36px; font-size: 10px; color: var(--ink-3); }
  .ruler__track { position: absolute; right: 0; top: 50%; display: grid; gap: 0; will-change: transform; }
  .ruler__track span { position: relative; height: 18px; width: 36px; text-align: right; padding-right: 14px; line-height: 0; }
  .ruler__track span::after { content: ''; position: absolute; right: 0; top: 0; width: 6px; height: 1px; background: var(--ink-3); }
  .ruler__track span.is-major::after { width: 10px; background: var(--ink-2); }
  .ruler__needle { position: absolute; right: -6px; top: 50%; width: 22px; height: 2px; background: var(--accent); box-shadow: 0 0 10px var(--accent); }

  @media (max-width: 760px) {
    .descent { height: 380vh; }
    .stratum.is-left, .stratum.is-right {
      left: var(--pad); right: auto; margin: 0; padding: 18px; gap: 10px;
      inset-block: auto calc(15svh + env(safe-area-inset-bottom)); width: calc(100% - var(--pad) * 2 - 34px);
    }
    /* a slim rail: ticks and the needle, no numbers to crowd the cards */
    .ruler { width: 14px; }
    .ruler__track span { width: 14px; padding: 0; color: transparent; }
    .stratum__body { font-size: 14.5px; }
    .reel { aspect-ratio: 2 / 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .descent { height: auto; }
    .descent__stick { position: static; height: auto; display: grid; gap: 24px; padding: 80px var(--pad); }
    .stratum { position: static; margin: 0; visibility: visible; opacity: 1 !important; width: auto; max-width: 560px; }
    .ruler { display: none; }
  }
</style>
