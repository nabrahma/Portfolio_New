---
import { getImage } from 'astro:assets';
import { renders } from '../../data/three-d';
// The 3D side: a pinned film strip that runs sideways while you scroll down.
const featured = renders.filter((r) => r.featured);
const imgs = await Promise.all(featured.map((r) => getImage({ src: r.image, width: 1100, format: 'webp' })));
---

<section id="three-d" class="w3d" aria-labelledby="three-title">
  <header class="w3d__head wrap">
    <p class="t-mono"><span class="t-accent">Index 003</span> <span class="t-faint">/</span> 3D_WORLD <span class="t-faint">— unlocked</span></p>
    <h2 id="three-title" class="t-h1" data-split>The other half.<br /><span class="t-faint">One figure, {renders.length} places.</span></h2>
    <p class="t-lead t-dim w3d__lead">When I’m not designing interfaces, I build small worlds in 3D: rooms, woods, streets and weather, lit for one person who is usually alone in them.</p>
  </header>

  <div class="w3d__pin" data-strip>
    <div class="w3d__track" data-strip-track>
      <figure class="w3d__card w3d__card--intro win">
        <div class="win__bar"><span class="win__dots"><i></i><i></i><i></i></span><span>3d_generalist.exe</span></div>
        <canvas class="ascii" data-ascii role="img" aria-label="A rotating donut drawn with letters"></canvas>
        <figcaption class="t-mono t-faint">fig. 3 — every 3D artist starts with a donut. Then it gets out of hand →</figcaption>
      </figure>

      {featured.map((r, i) => {
        const im = imgs[i];
        const wide = r.image.width > r.image.height;
        return (
          <a class:list={['w3d__card', 'w3d__frame', { 'is-wide': wide }]} href={`/3d#${r.slug}`} data-cursor="label:view render">
            <span class="w3d__label t-mono"><span class="t-pixel">R{String(i + 1).padStart(2, '0')}</span> {r.slug}.jpg</span>
            <span class="w3d__img"><img src={im.src} width={im.attributes.width} height={im.attributes.height} alt={r.alt} loading="lazy" decoding="async" /></span>
            <span class="w3d__title">{r.title}</span>
          </a>
        );
      })}

      <a class="w3d__card w3d__more" href="/3d" data-cursor="label:open folder">
        <span class="t-pixel w3d__more-n">{renders.length}</span>
        <span class="t-h3">renders in the folder</span>
        <span class="btn btn--solid">Open 3D_WORLD <span class="arr">→</span></span>
      </a>
    </div>
    <div class="w3d__meter wrap t-mono" aria-hidden="true">
      <span class="w3d__how">Scroll to run the reel</span>
      <span class="w3d__swipe">Swipe through {featured.length} renders <span class="arr">→</span></span>
      <span class="w3d__bar"><i data-strip-bar></i></span>
      <span class="tnum"><span data-strip-n>01</span> / {String(featured.length).padStart(2, '0')}</span>
    </div>
  </div>
</section>

<style>
  .w3d { position: relative; z-index: 2; background: var(--bg); padding-top: clamp(96px, 14vh, 160px); border-top: 1px solid var(--line); }
  .w3d__head { display: grid; gap: 20px; margin-bottom: clamp(24px, 4vh, 48px); }
  .w3d__lead { max-width: 56ch; }
  .w3d__pin { height: 100svh; display: grid; grid-template-rows: 1fr auto; grid-template-columns: minmax(0, 1fr); overflow: hidden; padding-bottom: 40px; }
  .w3d__track {
    display: flex; align-items: center; gap: clamp(16px, 2vw, 32px);
    padding: 24px var(--pad); width: max-content; will-change: transform;
  }
  .w3d__card { flex: none; height: min(64svh, 620px); }
  /* the drum (home.ts, initStrip): cards turn as they pass the middle */
  .w3d__pin.is-drum { perspective: 1600px; }
  .w3d__pin.is-drum .w3d__track { transform-style: preserve-3d; }
  .w3d__pin.is-drum .w3d__card { will-change: transform; }
  .w3d__card--intro { width: min(46vw, 520px); height: auto; margin: 0; }
  .w3d__card--intro .ascii { width: 100%; aspect-ratio: 4 / 3; }
  .w3d__card--intro figcaption { padding: 10px 12px; border-top: 1px solid var(--line); text-transform: none; }

  .w3d__frame {
    position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 8px;
    aspect-ratio: 4 / 5; height: min(64svh, 620px);
  }
  .w3d__frame.is-wide { aspect-ratio: 16 / 10.4; }
  .w3d__label { display: flex; gap: 8px; color: var(--ink-2); text-transform: none; }
  .w3d__label .t-pixel { color: var(--accent-ink); }
  .w3d__img { position: relative; overflow: hidden; background: #050505; border: 1px solid var(--line-strong); }
  .w3d__img img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); transition: transform 1.2s var(--ease-out), filter 0.4s; filter: saturate(0.9); }
  .w3d__frame:hover .w3d__img img { transform: scale(1.04); filter: saturate(1.1); }
  .w3d__img::after {
    /* scanlines that clear on hover, like a CRT warming up */
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.08) 0 1px, transparent 1px 3px);
    transition: opacity 0.5s;
  }
  .w3d__frame:hover .w3d__img::after { opacity: 0; }
  .w3d__title { font-size: 17px; letter-spacing: -0.015em; }

  .w3d__more { width: min(36vw, 380px); display: grid; align-content: center; justify-items: start; gap: 16px; padding: 32px; border: 1px dashed var(--line-strong); }
  .w3d__more-n { font-size: clamp(72px, 9vw, 140px); line-height: 0.85; color: var(--accent-ink); }

  .w3d__meter { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; }
  .w3d__swipe { display: none; }
  .w3d__bar { height: 2px; background: var(--line); }
  .w3d__bar i { display: block; height: 100%; width: 100%; background: var(--accent-ink); transform: scaleX(0); transform-origin: left; }

  @media (max-width: 760px), (prefers-reduced-motion: reduce) {
    .w3d__pin { height: auto; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad); padding-bottom: 72px; scrollbar-width: none; }
    .w3d__pin::-webkit-scrollbar { display: none; }
    .w3d__card { scroll-snap-align: start; height: 58svh; }
    .w3d__frame { height: 58svh; }
    .w3d__card--intro { display: none; }
    .w3d__track { gap: 14px; }
    .w3d__frame, .w3d__frame.is-wide { height: auto; width: 80vw; aspect-ratio: auto; grid-template-rows: auto auto auto; }
    .w3d__frame .w3d__img { aspect-ratio: 4 / 5; }
    .w3d__frame.is-wide .w3d__img { aspect-ratio: 4 / 5; }
    .w3d__more { width: 70vw; }
    /* the sideways reel is a swipe here: say so, and pin the hint under the strip */
    .w3d__meter { position: sticky; left: 0; grid-template-columns: auto; padding-top: 6px; color: var(--ink-2); font-size: 12px; }
    .w3d__how, .w3d__bar, .w3d__meter > .tnum { display: none; }
    .w3d__swipe { display: inline; }
  }
</style>
