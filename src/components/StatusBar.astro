---
import { site } from '../data/site';
const { page } = Astro.props as { page: string };
---

<footer class="statusbar t-mono" aria-hidden="true">
  <span>From {site.location}</span>
  <span class="sb-hide">{site.role} <span class="t-faint">+</span> {site.roleNext}</span>
  <span class="sb-hide sb-status"><i class="led"></i>{site.status}</span>
  <span class="tnum sb-meter">
    {page === 'home'
      ? <><span class="t-faint" id="meter-label">ALT</span> <span id="meter">+000.0</span> m</>
      : <><span class="t-faint">Read</span> <span id="meter">000</span>%</>}
  </span>
</footer>

<style>
  .statusbar {
    position: fixed; inset: auto 0 0 0; z-index: 100;
    height: 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding-inline: var(--pad);
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    font-size: 10.5px;
  }
  .sb-status { display: inline-flex; align-items: center; gap: 8px; }
  .led { width: 6px; height: 6px; background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: blink 2.4s steps(2, jump-none) infinite; }
  @keyframes blink { 50% { opacity: 0.35; } }
  .sb-meter { min-width: 116px; text-align: right; }
  @media (max-width: 760px) { .sb-hide { display: none; } }
</style>
