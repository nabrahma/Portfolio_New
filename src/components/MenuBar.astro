---
import { site } from '../data/site';
const { page } = Astro.props as { page: string };
const home = page === 'home' ? '' : '/';
const nav = [
  { label: 'Work', href: `${home}#work`, n: '01' },
  { label: 'About', href: `${home}#about`, n: '02' },
  { label: '3D', href: `${home}#three-d`, n: '03' },
  { label: 'Letters', href: `${home}#letters`, n: '04' },
];
---

<header class="menubar" role="banner">
  <a class="menubar__logo" href="/" aria-label={`${site.name}, home`} data-cursor="link">
    <span class="logo-mark t-pixel" aria-hidden="true">NB<b>—</b>OS</span>
    <span class="menubar__name t-mono" data-scramble>{site.name}</span>
  </a>

  <nav class="menubar__nav" aria-label="Primary">
    {nav.map((n) => (
      <a href={n.href} class="t-mono menubar__link" data-scramble>
        <span class="t-faint">{n.n}</span> {n.label}
      </a>
    ))}
  </nav>

  <div class="menubar__tray">
    <span class="t-mono tnum menubar__clock" aria-label="Local time in India"><span class="t-faint">{site.tzLabel}</span> <span id="clock">--:--</span></span>

    <div class="phosphor" role="radiogroup" aria-label="Accent phosphor">
      {['green', 'amber', 'ice', 'red'].map((p) => (
        <button role="radio" class={`phosphor__swatch is-${p}`} data-phosphor-set={p} aria-label={`${p} phosphor`} aria-checked="false" data-cursor="link"></button>
      ))}
    </div>

    <button class="tray-btn t-mono" id="sound-toggle" aria-pressed="false" data-cursor="link" title="Sound and music">
      <span class="t-pixel">♪</span><span class="sr-only">Sound</span><span class="tray-btn__state">off</span>
    </button>
    <button class="tray-btn t-mono" id="theme-toggle" data-cursor="link" aria-label="Switch light or dark mode">
      <span class="theme-ico" aria-hidden="true"></span><span class="tray-btn__state theme-label">mode</span>
    </button>
  </div>
</header>

<style>
  .menubar {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    height: var(--bar-h);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding-inline: var(--pad);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
  }
  .menubar__logo { display: inline-flex; align-items: center; gap: 12px; justify-self: start; }
  .logo-mark { font-size: 13px; padding: 3px 6px; background: var(--ink); color: var(--bg); line-height: 1; }
  .logo-mark b { color: var(--accent); font-weight: 400; }
  .menubar__nav { display: flex; gap: clamp(14px, 2.4vw, 36px); }
  .menubar__link { position: relative; padding: 8px 0; transition: color 0.2s; }
  .menubar__link:hover { color: var(--accent-ink); }
  .lock { margin-left: 4px; font-size: 10px; color: var(--ink-3); }
  .menubar__tray { justify-self: end; display: flex; align-items: center; gap: 14px; }
  .phosphor { display: flex; gap: 4px; padding: 0 2px; }
  .phosphor__swatch { width: 11px; height: 11px; border: 1px solid var(--line-strong); transition: transform 0.2s var(--ease-out); }
  .phosphor__swatch:hover { transform: translateY(-2px); }
  .phosphor__swatch[aria-checked='true'] { outline: 1px solid var(--ink); outline-offset: 2px; }
  .is-green { background: #39ff88; } .is-amber { background: #ffb020; } .is-ice { background: #7cc8ff; } .is-red { background: #ff5040; }
  .tray-btn { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 8px; border: 1px solid var(--line); }
  .tray-btn:hover { border-color: var(--line-strong); }
  .tray-btn__state { color: var(--ink-2); }
  .theme-ico { width: 11px; height: 11px; border: 1px solid var(--ink); background: linear-gradient(90deg, var(--ink) 50%, transparent 50%); }

  @media (max-width: 900px) {
    .menubar__name, .menubar__clock, .phosphor, .tray-btn__state { display: none; }
    .menubar { grid-template-columns: auto 1fr auto; gap: 12px; }
    .menubar__nav { justify-self: center; gap: 14px; }
    .menubar__nav .t-faint { display: none; }
  }
  @media (max-width: 420px) { .menubar__nav { gap: 10px; } }
  @media (max-width: 560px) { .menubar__nav { font-size: 12px; } }
</style>
