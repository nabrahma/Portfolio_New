---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// An image on a specimen panel. kind: phone (screen PNG), graphic (chart/diagram), wide (web screenshot)
interface Props {
  src: ImageMetadata;
  alt: string;
  kind?: 'phone' | 'graphic' | 'wide';
  title?: string;
  caption?: string;
  panel?: string;
  width?: number;
}
const { src, alt, kind = 'phone', title, caption, panel, width } = Astro.props;
const w = width ?? (kind === 'phone' ? 640 : 1600);
const img = await getImage({ src, width: Math.min(w, src.width), format: 'webp' });
const img2 = kind !== 'phone' && src.width > 900 ? await getImage({ src, width: 900, format: 'webp' }) : null;
---

<figure class={`shot shot--${kind}`} style={panel ? `--panel:${panel}` : undefined}>
  <div class="shot__frame" data-pixel>
    <img
      src={img.src}
      srcset={img2 ? `${img2.src} 900w, ${img.src} ${img.attributes.width}w` : undefined}
      sizes={img2 ? '(max-width: 1000px) 100vw, 900px' : undefined}
      width={img.attributes.width}
      height={img.attributes.height}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  {(title || caption) && (
    <figcaption>
      {title && <span class="shot__t">{title}</span>}
      {caption && <span class="shot__c">{caption}</span>}
    </figcaption>
  )}
</figure>
