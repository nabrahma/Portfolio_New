---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// A pinned phone whose frames advance with scroll, like flicking through a prototype.
interface Props { frames: { src: ImageMetadata; label: string }[]; alt: string; panel: string; dark?: boolean }
const { frames, alt, panel, dark = false } = Astro.props;
const imgs = await Promise.all(frames.map((f) => getImage({ src: f.src, width: 560, format: 'webp' })));
---

<div class:list={['flip', { 'is-dark': dark }]} data-flip style={`--panel:${panel}; --n:${frames.length}`}>
  <div class="flip__stage">
    <div class:list={['flip__phone', { 'is-dark': dark }]} role="img" aria-label={alt}>
      {imgs.map((im, i) => (
        <img src={im.src} width={im.attributes.width} height={im.attributes.height} alt="" loading={i === 0 ? 'eager' : 'lazy'} class={i === 0 ? 'is-on' : ''} />
      ))}
    </div>
    <ol class="flip__ticks t-mono" aria-hidden="true">
      {frames.map((f, i) => <li class={i === 0 ? 'is-on' : ''}><span class="t-pixel">{String(i + 1).padStart(2, '0')}</span> {f.label}</li>)}
    </ol>
  </div>
</div>

<style>
  .flip { height: calc(60vh + var(--n) * 22vh); position: relative; }
  .flip__stage {
    position: sticky; top: calc(var(--bar-h) + 24px); height: calc(100svh - var(--bar-h) - 80px);
    display: grid; grid-template-columns: minmax(0, 1fr) 220px; grid-template-rows: minmax(0, 1fr); gap: 24px; align-items: center;
    background: var(--panel); border: 1px solid var(--line); padding: 24px;
  }
  .flip__phone { position: relative; height: 100%; max-height: 760px; width: auto; aspect-ratio: 786 / 1704; justify-self: center; align-self: center; }
  .flip__phone img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity 0.18s linear; }
  .flip__phone img.is-on { opacity: 1; }
  .flip__ticks { list-style: none; padding: 0; display: grid; gap: 6px; color: #6b6b66; text-transform: none; }
  .flip__ticks li { transition: color 0.2s, transform 0.3s var(--ease-out); }
  .flip__ticks li.is-on { color: #111; transform: translateX(6px); }
  .flip__ticks .t-pixel { margin-right: 6px; }
  .flip.is-dark .flip__ticks { color: #8d8a84; }
  .flip.is-dark .flip__ticks li.is-on { color: #f4efe6; }
  @media (max-width: 760px) {
    .flip__stage { grid-template-columns: minmax(0, 1fr); padding: 16px; }
    .flip__ticks { display: none; }
  }
</style>

<script>
  import { ScrollTrigger, $$ } from '../../scripts/core';
  $$('[data-flip]').forEach((el) => {
    const imgs = $$('img', el);
    const ticks = $$('li', el);
    let cur = 0;
    ScrollTrigger.create({
      trigger: el,
      start: 'top top+=60',
      end: 'bottom bottom',
      onUpdate: (s) => {
        const i = Math.min(imgs.length - 1, Math.floor(s.progress * imgs.length));
        if (i === cur) return;
        imgs[cur].classList.remove('is-on'); ticks[cur].classList.remove('is-on');
        imgs[i].classList.add('is-on'); ticks[i].classList.add('is-on');
        cur = i;
      },
    });
  });
</script>
