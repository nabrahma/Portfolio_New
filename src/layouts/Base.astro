---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import MenuBar from '../components/MenuBar.astro';
import StatusBar from '../components/StatusBar.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  page?: string; // 'home' | 'case' | ...
  ogImage?: string;
}
const { title, description = site.description, page = 'page', ogImage } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1f0eb" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Runs before paint: theme, phosphor, and the arriving page-wipe cover.
      (function () {
        var d = document.documentElement;
        var s = localStorage;
        var t = s.getItem('nb-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        d.dataset.theme = t;
        var p = s.getItem('nb-phosphor');
        if (p && p !== 'green') d.dataset.phosphor = p;
        d.classList.add('js');
        if (sessionStorage.getItem('nb-wipe') === '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('is-arriving');
        // Landing: the site decides where a page opens, not the browser. A reload starts at the
        // top, so drop a section hash before the browser jumps to it (/letter and /3d hashes are data).
        try {
          history.scrollRestoration = 'manual';
          var nav = performance.getEntriesByType('navigation')[0];
          if (nav && nav.type === 'reload' && location.hash && !/^\/(letter|3d)/.test(location.pathname)) history.replaceState(null, '', location.pathname + location.search);
        } catch (e) {}
      })();
    </script>
    <style is:global>
      .is-arriving .pixel-wipe { background: var(--ink); }
      /* covers the page from the very first paint, before the canvas is parsed */
      .is-arriving body::before { content: ''; position: fixed; inset: 0; z-index: 8999; background: var(--ink); }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <MenuBar page={page} />
    <main id="main">
      <slot />
    </main>
    <StatusBar page={page} />

    <div class="cursor" aria-hidden="true">
      <i class="cursor__trail"></i><i class="cursor__trail"></i><i class="cursor__trail"></i>
      <i class="cursor__dot"></i>
      <span class="cursor__label"></span>
    </div>
    <canvas class="pixel-wipe" aria-hidden="true"></canvas>

    <script>
      import { boot } from '../scripts/app';
      boot();
    </script>
  </body>
</html>
