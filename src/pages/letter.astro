---
import '@fontsource/caveat/400.css';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="A letter" page="letter" description="A letter left in the mailroom.">
  <meta name="robots" content="noindex" slot="head" />
  <section class="lv wrap" data-letter-view>
    <header class="lv__head">
      <p class="t-mono"><span class="t-accent">Mailroom</span> <span class="t-faint">/</span> Opened letter <span class="t-faint">— came up the tube</span></p>
      <h1 class="t-h1 lv__title" data-letter-title>Opening the envelope…</h1>
      <p class="t-lead t-dim" data-letter-status></p>
    </header>

    <div class="lv__desk" data-letter-desk hidden>
      <div class="lv__paper-wrap">
        <canvas class="lv__paper" aria-describedby="letter-text"></canvas>
      </div>

      <aside class="lv__side">
        <div class="lv-env" aria-hidden="true">
          <div class="lv-env__flap"></div>
          <div class="lv-env__stamp" data-lv-stamp></div>
          <div class="lv-env__pm t-mono">Mailroom<br /><b data-lv-pm></b></div>
          <p class="lv-env__from t-mono"><span class="t-faint">From</span> <span data-lv-from></span></p>
          <p class="lv-env__to">{site.name}<br /><span class="t-mono">The Archive, −44 m</span></p>
          <span class="lv-env__tear"></span>
        </div>

        <dl class="lv-receipt t-mono">
          <div><dt>From</dt><dd data-lv-name></dd></div>
          <div><dt>Sent</dt><dd data-lv-date></dd></div>
          <div><dt>Stamp</dt><dd data-lv-stampname></dd></div>
          <div><dt>Words</dt><dd class="tnum" data-lv-words></dd></div>
          <div><dt>Doodle</dt><dd data-lv-strokes></dd></div>
        </dl>

        <figure class="lv-transcript">
          <figcaption class="t-mono t-faint">Transcript</figcaption>
          <p id="letter-text" data-letter-text></p>
        </figure>

        <div class="lv__actions">
          <a class="btn btn--solid" href="/#letters">Write one back <span class="arr">✉</span></a>
          <a class="btn" href="/">Back to the surface <span class="arr">↑</span></a>
        </div>
      </aside>
    </div>

    <a class="btn lv__home" href="/" data-letter-fallback>Back to the surface <span class="arr">↑</span></a>
  </section>
</Base>

<style>
  .lv { min-height: 100svh; padding-top: calc(var(--bar-h) + 48px); padding-bottom: 120px; display: grid; gap: clamp(28px, 5vh, 56px); align-content: start; max-width: 1480px; margin-inline: auto; }
  .lv__head { display: grid; gap: 14px; }
  .lv__title { max-width: 20ch; }
  .lv__title :global(.hand) { font-family: var(--font-hand); font-weight: 400; letter-spacing: 0; color: var(--accent-ink); }

  .lv__desk { display: grid; grid-template-columns: minmax(0, 640px) minmax(300px, 1fr); gap: clamp(28px, 5vw, 88px); align-items: start; }
  .lv__desk[hidden] { display: none; }
  .lv__paper-wrap { perspective: 1400px; }
  .lv__paper { display: block; width: 100%; height: auto; box-shadow: 0 1px 0 rgb(0 0 0 / 0.04), 0 40px 70px -34px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(0 0 0 / 0.08); transform-origin: 50% 100%; }

  .lv__side { display: grid; gap: 28px; max-width: 520px; position: sticky; top: calc(var(--bar-h) + 24px); }

  /* the envelope it came in, slit open along the top */
  .lv-env { position: relative; aspect-ratio: 1.6; margin-top: min(28vw, 136px); /* clears the open flap */ background: #e9e3d3; color: #161616; border: 1px solid #161616; transform: rotate(2deg); box-shadow: -10px 10px 0 -1px var(--bg), -10px 10px 0 0 var(--line-strong); }
  .lv-env::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to top right, transparent calc(50% - 0.6px), #161616 50%, transparent calc(50% + 0.6px)) left bottom / 50% 64% no-repeat, linear-gradient(to top left, transparent calc(50% - 0.6px), #161616 50%, transparent calc(50% + 0.6px)) right bottom / 50% 64% no-repeat; opacity: 0.16; }
  .lv-env__flap { position: absolute; left: -1px; right: -1px; bottom: 100%; height: 38%; background: #ddd6c5; border: 1px solid #161616; clip-path: polygon(0 100%, 50% 0, 100% 100%); transform-origin: bottom; }
  .lv-env__tear { position: absolute; left: 4%; right: 4%; top: -1px; height: 4px; background: repeating-linear-gradient(90deg, #161616 0 5px, transparent 5px 9px); opacity: 0.5; }
  .lv-env__stamp { position: absolute; right: 6%; top: 10%; width: 15%; aspect-ratio: 52 / 58; padding: 4px; background: #fff; outline: 2px dotted #b8b4a8; outline-offset: -2px; }
  .lv-env__stamp :global(svg) { width: 100%; height: 100%; }
  .lv-env__pm { position: absolute; right: 21%; top: 9%; width: 21%; aspect-ratio: 1; border-radius: 50%; border: 1.5px solid #3a3a3a; display: grid; place-items: center; text-align: center; font-size: 8px; line-height: 1.3; color: #3a3a3a; transform: rotate(-14deg); opacity: 0.6; }
  .lv-env__from { position: absolute; left: 6%; top: 11%; font-size: 10px; text-transform: none; max-width: 44%; overflow-wrap: anywhere; }
  .lv-env__from .t-faint { color: #6b6b66; }
  .lv-env__to { position: absolute; left: 30%; bottom: 12%; font: 400 clamp(20px, 1.8vw, 28px)/1.05 var(--font-hand); }
  .lv-env__to .t-mono { font-size: 10px; }

  .lv-receipt { display: grid; margin: 0; border-top: 1px solid var(--line-strong); text-transform: none; font-size: 12.5px; }
  .lv-receipt div { display: grid; grid-template-columns: 9ch 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px dashed var(--line); }
  .lv-receipt dt { color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.04em; font-size: 11px; }
  .lv-receipt dd { margin: 0; }

  .lv-transcript { margin: 0; padding: 18px 20px; border: 1px solid var(--line); background: color-mix(in srgb, var(--ink) 3%, transparent); display: grid; gap: 10px; }
  .lv-transcript p { white-space: pre-wrap; font: 400 15px/1.6 var(--font-sans); color: var(--ink-2); max-height: 40vh; overflow: auto; }
  .lv__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .lv__home { justify-self: start; }
  .lv__desk:not([hidden]) ~ .lv__home { display: none; }

  @media (max-width: 960px) {
    .lv__desk { grid-template-columns: 1fr; }
    .lv__side { position: static; max-width: none; }
    .lv-env { max-width: 420px; }
  }
</style>
